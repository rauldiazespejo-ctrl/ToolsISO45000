generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id          String   @id @default(cuid())
  name        String   // Razón Social
  rut         String   // RUT empresa
  business    String   // Giro
  address     String   // Dirección
  size        String   // MIPYME / Mediana / Grande
  workerCount Int      // Número de trabajadores
  sector      String   // Sector económico
  logoData         String?  @db.Text // Base64 logo data
  signatoriesJson  String?  @db.Text // Firmas DocuSign JSON
  brandingJson     String?  @db.Text // brandPalette + brandingMode
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  documents        SstDocument[]
  bowties          BowtieAnalysis[]
}

model SstDocument {
  id          String   @id @default(cuid())
  number      Int      // N° documento (1-46)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // From Excel
  category    String   // A, B, C, etc.
  name        String   // Nombre documento
  description String   // Descripción/Alcance
  responsible String   // Responsable
  priority    String   // Alta / Media
  normSource  String   // Fuente normativa
  normRef     String   // Referencia norma
  
  // Status tracking
  status      String   @default("Pendiente") // Pendiente, En Proceso, Completado, No Aplica
  
  // Generated content
  generatedContent String? // AI-generated content (markdown)
  auditChecksJson  String? @db.Text // Checklist anti-devolución JSON
  aiReviewJson     String? @db.Text // Última revisión multiagente
  docxPath         String? // Path to generated .docx file
  version          Int     @default(1)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BowtieAnalysis {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code         String
  title        String
  hazard       String
  topEvent     String
  activity     String   @default("")
  area         String   @default("")
  criticality  String   // critico | alto
  diagramData  String   @db.Text // JSON BowtieModel v1
  markdown     String?  @db.Text
  status       String   @default("generado")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
}

model GenerationLog {
  id         String   @id @default(cuid())
  companyId  String
  docId      String?
  action     String   // generate, edit, download
  status     String   // success, error
  message    String?
  createdAt  DateTime @default(now())
}
