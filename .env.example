# PostgreSQL (recomendado: https://neon.tech — capa gratuita compatible con Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Opcional: protege APIs de IA/generación frente a llamadas externas.
# La UI del mismo origen (localhost o su dominio) sigue funcionando sin header.
# Integraciones externas: header x-pulso-api-key con este valor.
INTERNAL_API_SECRET=""
